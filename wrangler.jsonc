// Cloudflare Workers config. The site is fully static: `pnpm run build` (nuxt generate)
// writes plain HTML to .output/public and Cloudflare serves those files as-is.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acaciaclimbing",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./.output/public",
    "not_found_handling": "404-page",
    // Serve pages at /about (no trailing slash), the same address every link on the site uses,
    // so Google never has to follow a redirect to reach a page. /about/ redirects to /about.
    "html_handling": "drop-trailing-slash"
  }
}
